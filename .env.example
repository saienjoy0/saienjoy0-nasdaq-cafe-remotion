# Do not commit a real key. Copy this file to .env.local and set a newly issued key.
# The Gemini-specific npm commands load .env.local with Node's --env-file-if-exists option.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
TTS_PROVIDER=gemini
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Charon
