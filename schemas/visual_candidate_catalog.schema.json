{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/schemas/visual_candidate_catalog.schema.json",
  "title": "NASDAQ Cafe Visual Candidate Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "episodeDate", "rendererContractVersion", "sourceRenderSpecSha256", "candidates"],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "episodeDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "rendererContractVersion": {"const": "2.4.0"},
    "sourceRenderSpecSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "visualBeatId", "capability", "visualTemplate", "templateVariant", "screenState", "visualMode", "templateConfig", "appearanceClass", "dominantSurface", "realityAnchor", "evidenceSourceIds", "objectIds", "assetPlacementIds", "assetIds", "assetState", "requirementsSatisfied"],
        "properties": {
          "candidateId": {"type": "string", "pattern": "^vc-[A-Za-z0-9._-]+$"},
          "visualBeatId": {"type": "string"},
          "capability": {"enum": ["source-document", "quote-social", "time-series", "comparison-set", "gap", "causal-graph", "entity", "image-media", "verification", "text-only"]},
          "visualTemplate": {"type": "string"},
          "templateVariant": {"type": "string"},
          "screenState": {"enum": ["Data", "Chart", "EntityFocus", "MainWithEntity", "PictureBook", "News"]},
          "visualMode": {"type": "string"},
          "templateConfig": {"type": "object"},
          "appearanceClass": {"type": "string"},
          "dominantSurface": {"type": "string"},
          "realityAnchor": {"type": "boolean"},
          "evidenceSourceIds": {"type": "array", "items": {"type": "string"}},
          "objectIds": {"type": "array", "items": {"type": "string"}},
          "assetPlacementIds": {"type": "array", "items": {"type": "string"}},
          "assetIds": {"type": "array", "items": {"type": "string"}},
          "assetState": {"enum": ["ready", "user-review-required", "not-required"]},
          "requirementsSatisfied": {"const": true}
        }
      }
    }
  }
}
