{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nasdaq-cafe.local/schemas/visual_direction_plan.schema.json",
  "title": "NASDAQ Cafe Visual Direction Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "episodeDate", "candidateCatalogSha256", "selections"],
  "properties": {
    "contractVersion": {"const": "1.0.0"},
    "episodeDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "candidateCatalogSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["visualBeatId", "candidateId"],
        "properties": {
          "visualBeatId": {"type": "string"},
          "candidateId": {"type": "string", "pattern": "^vc-[A-Za-z0-9._-]+$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
