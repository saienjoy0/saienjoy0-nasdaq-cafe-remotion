{
  "name": "nasdaq-cafe-remotion",
  "version": "1.0.0",
  "description": "朝のNASDAQカフェ Phase 1 video renderer",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource-variable/noto-sans-jp": "5.2.10",
    "@google/genai": "2.11.0",
    "@remotion/bundler": "4.0.487",
    "@remotion/captions": "4.0.487",
    "@remotion/cli": "4.0.487",
    "@remotion/media": "4.0.487",
    "@remotion/renderer": "4.0.487",
    "@remotion/transitions": "4.0.487",
    "mdast-util-from-markdown": "^2.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.487",
    "simple-icons": "16.27.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.487",
    "@types/node": "22.15.3",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "tsx": "4.20.3",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts dist/remotion",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc",
    "lint": "eslint src scripts && tsc",
    "validate:sample": "tsx scripts/validate-episode.ts samples/episode_data.sample.json",
    "validate:episode": "tsx scripts/validate-episode.ts",
    "test:inputs": "tsx scripts/test-inputs.ts",
    "list:compositions": "remotion compositions src/index.ts",
    "render:sample": "tsx scripts/render-episode.ts samples/episode_data.sample.json",
    "render:episode": "tsx scripts/render-episode.ts",
    "render:stills": "tsx scripts/render-stills.ts",
    "preview:stills": "tsx scripts/render-stills.ts",
    "prepare:episode": "tsx scripts/prepare-episode.ts",
    "generate:voiceover": "tsx scripts/generate-voiceover.ts",
    "generate:voiceover:gemini": "node --env-file-if-exists=.env.local --import tsx scripts/spec-cli.ts compile",
    "preview:episode": "tsx scripts/render-preview.ts",
    "inspect:final": "tsx scripts/inspect-final.ts",
    "episode:build": "tsx scripts/episode-build.ts",
    "episode:build:gemini": "node --env-file-if-exists=.env.local --import tsx scripts/spec-cli.ts final",
    "episode:spec:validate": "tsx scripts/spec-cli.ts validate",
    "episode:spec:compile": "tsx scripts/spec-cli.ts compile",
    "episode:spec:preview": "tsx scripts/spec-cli.ts preview",
    "episode:spec:final": "tsx scripts/spec-cli.ts final",
    "episode:spec:inspect": "tsx scripts/spec-cli.ts inspect",
    "episode:spec:inspect:preview": "tsx scripts/inspect-preview.ts",
    "episode:spec:ready": "tsx scripts/create-production-ready.ts",
    "episode:spec:fixture:still": "tsx scripts/spec-cli.ts still",
    "episode:spec:fixture:compile": "tsx scripts/spec-cli.ts fixture-compile",
    "episode:spec:schema": "tsx scripts/generate-render-spec-schema.ts",
    "episode:spec:fixtures": "tsx scripts/generate-render-spec-fixtures.ts",
    "episode:spec:golden": "tsx scripts/render-spec-golden-stills.ts",
    "episode:spec:beat-stills": "tsx scripts/render-visual-beat-stills.ts",
    "test:spec:voicevox": "tsx scripts/test-spec-voicevox.ts",
    "test:spec:golden": "tsx scripts/test-spec-golden.ts",
    "test:spec:preview": "tsx scripts/test-expression-preview.ts",
    "test:gemini-tts": "tsx scripts/test-gemini-tts.ts",
    "test:gemini-key-pool": "node --import tsx scripts/test-gemini-api-key-pool.ts",
    "test:duration-policy": "tsx scripts/test-duration-policy.ts",
    "test:workflow-contract": "tsx scripts/test-workflow-contract.ts",
    "test:visual-sequence": "tsx scripts/test-visual-sequence.ts",
    "test:runtime-stability": "tsx scripts/test-workflow-contract.ts && tsx scripts/test-duration-policy.ts && tsx scripts/test-spec-inspect.ts && node --import tsx scripts/test-gemini-api-key-pool.ts && tsx scripts/test-visual-sequence.ts",
    "test:public-screen": "tsx scripts/test-public-screen.ts",
    "assets:reusable": "node scripts/generate-reusable-entity-assets.mjs",
    "test:reusable-assets": "node --import tsx scripts/test-reusable-entity-cues.ts",
    "stock-cards:logos": "node scripts/cache-stock-logos.mjs",
    "stock-cards:render": "node scripts/render-all-stock-cards.mjs",
    "stock-cards:all": "npm run stock-cards:logos && npm run stock-cards:render",
    "stock-cards:preview": "node --import tsx scripts/render-stock-card-integration-preview.ts",
    "test:stock-cards": "node --import tsx scripts/test-stock-cards.ts",
    "remaining-assets:data": "node scripts/generate-remaining-assets-data.mjs && node --import tsx scripts/generate-person-source-register.ts",
    "remaining-assets:render": "node scripts/render-remaining-assets.mjs",
    "remaining-assets:all": "npm run remaining-assets:data && npm run remaining-assets:render",
    "remaining-assets:preview": "node --import tsx scripts/render-remaining-assets-integration-preview.ts",
    "test:remaining-assets": "node --import tsx scripts/test-remaining-assets.ts",
    "test:spec": "tsx scripts/test-render-spec.ts && tsx scripts/test-spec-inspect.ts && tsx scripts/test-visual-sequence.ts"
  },
  "sideEffects": [
    "*.css"
  ]
}
